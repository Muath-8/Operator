# Optional only. Copy to .env.local-testing at the repository root.
# pnpm dev:local needs none of these credentials.
# pnpm dev:local:ai uses codex login (ChatGPT), never an API token pasted here.
LO_LOCAL_PORT=3100
# Optional absolute path to codex.exe / codex if it is not on PATH.
LO_CODEX_BIN=

# PayPal SANDBOX app credentials only; never put live credentials in this file.
# Create them at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
