# Full PostgreSQL backend configuration. For zero-key SQLite testing use pnpm dev:local.
# Optional local-only settings live in .env.local-testing.example.
NODE_ENV=development
LO_EXECUTION_MODE=local
LO_STORAGE_BACKEND=postgres
LO_LOCAL_AI=simulated
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=
# Production/sandbox require separate restricted Postgres logins, never a superuser.
DATABASE_FOUNDER_URL=
DATABASE_LEAD_URL=
DATABASE_SPECIALIST_URL=
DATABASE_POLICY_URL=
DATABASE_INGRESS_URL=
DATABASE_VOICE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional explicit local authentication; random 32+ character token, loopback only.
LO_DEV_FOUNDER_ID=
LO_DEV_AUTH_TOKEN=
OPENAI_API_KEY=
# Pin exact provider model versions after evaluating them; no silent fallback.
MODEL_FRONTIER=
MODEL_MID=
MODEL_SMALL=
MODEL_REVIEWER=
MODEL_REALTIME=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
MAX_PARALLEL_RUNS=4
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
TWILIO_REGISTERED_SMS_SENDER=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM=
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
SHOPIFY_API_VERSION=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
VOICE_PUBLIC_URL=
SENTRY_DSN=
# Generate 32 random bytes and encode base64; used for scoped credential/email encryption.
PROVIDER_ENCRYPTION_KEY=
DATABASE_DEMAND_PUBLIC_URL=
DATABASE_SCHEDULER_URL=
VOICE_INTERNAL_SECRET=
VOICE_ORIGIN=
WEBHOOK_ORIGIN=

# Metadata-only operational telemetry; raw provider/model/user content is excluded.
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_DSN=
OPENAI_TRACE_EXPORT_ENABLED=false
# Exact pinned model -> {inputPerMillion,cachedInputPerMillion,outputPerMillion,
# source: HTTPS pricing source,observedAt: ISO timestamp}. No guessed prices.
MODEL_PRICE_RATES_JSON=
# Integer micro-USD per founder per UTC day; required outside explicit local mode.
MODEL_FOUNDER_DAILY_CAP_MICRO_USD=
# Provisional USD 600 = 2 x explicitly assumed USD 300 mission estimate;
# replace after ten real missions, without changing collected measurements.
MODEL_MISSION_ALARM_MICRO_USD=600000000
DATABASE_OPERATOR_URL=
# Model -> {maximumCallMicroUsd,source,observedAt}; ceiling for the largest
# permitted single image request. Actual unknown charges keep this reservation.
MODEL_IMAGE_PRICE_CEILINGS_JSON=
# Realtime entries in MODEL_PRICE_RATES_JSON additionally require
# audioInputPerMillion,cachedAudioInputPerMillion,audioOutputPerMillion.
